# Wohin ausgerollt wird. Nach `deploy/ziel.env` kopieren und ausfuellen —
# diese Datei bleibt aus dem Repo heraus (.gitignore), weil Serveradressen
# und Schluesselpfade zu einer Installation gehoeren, nicht zum Programm.

DEPLOY_SERVER=root@203.0.113.10        # SSH-Ziel
DEPLOY_VPS_IP=203.0.113.10             # fuer die DNS-Pruefung
DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519   # privater Schluessel
DEPLOY_ORDNER=/docker                  # darunter liegt smg-<instanz>
DEPLOY_INSTANZ=dashboard               # Vorgabe, wenn kein Argument kommt
DEPLOY_HOST=                           # Rueckfall, wenn die .env keinen HOST hat
