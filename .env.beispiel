# Vorlage. Die echte .env liegt NUR auf dem Server im Ordner der Instanz,
# mit Rechten 600 — niemals im Repo.
#
# Alles hier ist optional. Eine Karte, deren Zugangsdaten fehlen, erscheint
# gar nicht erst; eingetragen werden kann fast alles auch spaeter in der
# Oberflaeche unter „Settings“. Die .env ist der Weg fuer das, was schon beim
# Start feststehen muss.

# ---------------------------------------------------------------- Profil
INSTANZ=dashboard                      # Ordner-, Container- und Routername
HOST=dashboard.example.org             # unter welcher Adresse es laeuft
HOST_REGEL=Host(`dashboard.example.org`)   # Traefik-Regel, Pflicht
PERSON_NAME=                           # Begruessung; leer = ohne Namen
TITEL=Dashboard                        # Ueberschrift in der Seitenleiste
FIRMA=                                 # kleine Zeile darunter; leer = keine
ANSPRECHPARTNER=                       # wer bei Fragen hilft; leer = „dein Team“

# Welche Karten diese Instanz zeigt — Auswahl UND Reihenfolge. Moeglich sind:
# todos, mail, kalender, bank, superchat, rechnungen, widerrufe, shop, faq.
# Leer = alle; sichtbar wird ohnehin nur, was eingerichtet ist.
KARTEN=
# Die Zahlen ganz oben. "quelle" nimmt die Vorgabezahl der Karte,
# "quelle:Kennzahl" einen Ausschnitt (etwa ein zweites Superchat-Postfach).
KOPFZAHLEN=
# Welche Termine im Kalender hervorgehoben werden (Stichwoerter im Titel).
KALENDER_HERVORHEBEN=

# Basic-Auth vor der ganzen Seite (jedes $ verdoppelt!).
# Zugaenge legt deploy/zugang-anlegen.sh auf dem Server an.
BASIC_AUTH_USERS=

# --------------------------------------------------------------- Zugaenge
# Buchhaltung (Karten „Offene Ausgangsrechnungen“ und „Bank-Abgleich“)
LEXWARE_API_KEY=

# Aufgaben — MCP-Adresse des Todomaster-Servers, z. B. https://…/mcp
TODOMASTER_URL=
TODOMASTER_TOKEN=
TODO_KATEGORIEN=                       # kommagetrennt, z. B. buchhaltung,einkauf
TODOMASTER_WEB=                        # optionaler Link im Kartenfuss

# Shop (Karten „Offene Bestellungen“ und „Widerrufe“)
WP_URL=
WC_KEY=
WC_SECRET=

# Superchat — eine Postfach-Kennung oder mehrere, kommagetrennt
SUPERCHAT_API_KEY=
SUPERCHAT_INBOX_ID=

# Posteingang: Postfaecher werden in der Oberflaeche angelegt (Settings →
# Postfaecher), je Postfach entweder Anbieter-API oder IMAP. Zusaetzliche
# Absender, die nie rot werden sollen:
MAIL_WERBUNG=                          # kommagetrennt, z. B. @lieferant.de

# Kalender — Kennung des Google-Kalenders. Es gibt zwei Wege zum Zugang:
#
#   1. Anmelden (empfohlen): Client-ID und Geheimnis eines OAuth-Clients vom
#      Typ „Webanwendung" eintragen, dann unter Settings auf „Mit Google
#      anmelden" druecken. Sonst nichts — kein Volume, kein Neustart.
#      ACHTUNG: Der Zustimmungsbildschirm muss in der Google-Konsole auf
#      „In Produktion" stehen. Bei „Test" verfaellt die Anmeldung nach
#      7 Tagen, und die Karte ist woechentlich tot.
#   2. Dienstkonto: Schluesseldatei als Volume mounten (GOOGLE_ORDNER_HOST
#      weiter unten) und den Kalender fuer die Adresse des Dienstkontos
#      freigeben.
#
# Liegt beides vor, gilt die Anmeldung — sie ist die ausdrueckliche Wahl.
KALENDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Setzt der Knopf von selbst; hier nur noetig, wenn die Anmeldung anderswo
# erzeugt wurde.
GOOGLE_REFRESH_TOKEN=

# Zulieferungen von außen — alle optional. Ohne Angabe wird ein leerer Ordner
# eingehängt und die betroffenen Karten melden sich als „nicht eingerichtet".
# GOOGLE_ORDNER_HOST ist der ORDNER, in dem google-key.json liegt.
BANK_ORDNER_HOST=
WIDERRUF_ORDNER_HOST=
WATCHDOG_ORDNER_HOST=
GOOGLE_ORDNER_HOST=

# Wissensbasis fuer die Karte „FAQ-Nachschlag“: volle MCP-Adresse,
# der Schluessel steckt im Pfad.
FAQ_MCP_URL=
FAQ_WEB=                               # optionaler Link im Kartenfuss

# Zeiterfassung (clockin): Nummer der Person fuer die Zeitzeile im Kopf.
CLOCKIN_PERSON_ID=

# Arbeitszeiten dieser Person — steuert, wann die Takte holen.
# Format "Mo 8:00-15:15, Di 13:20-18:00, ..."
# Leer = es wird rund um die Uhr geholt.
ARBEITSZEITEN=

# Zugang fuer eine KI (MCP). Erzeugen mit: openssl rand -hex 24
MCP_TOKEN=

# Wohin gemeldet wird, sobald jemand auf eine KI-Nachricht antwortet.
ANTWORT_WEBHOOK_URL=
ANTWORT_WEBHOOK_BEARER=
ANTWORT_WEBHOOK_SECRET=
